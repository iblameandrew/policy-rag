# Optional. When empty, PolicyRAG uses MockLLM and never leaves the box.
OPENAI_API_KEY=

# Persistent Chroma directory (compose overrides this to /app/chroma).
CHROMA_DIR=./chroma

# Path to the dummy handbook.
HANDBOOK_PDF=data/employee_handbook.pdf

# Set to 1 in tests to skip downloading all-MiniLM-L6-v2.
POLICYRAG_FAKE_EMBEDDINGS=

# Chroma client telemetry (off).
ANONYMIZED_TELEMETRY=False
